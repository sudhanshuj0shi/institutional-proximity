# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development

# Owner/migration connection (used only by `npm run db:migrate` and seeding).
DATABASE_URL_OWNER=postgres://ip_owner:CHANGE_ME@localhost:5432/institutional_proximity

# Least-privilege runtime connections. The public pool can only read public_api views.
DATABASE_URL_PUBLIC=postgres://ip_public:CHANGE_ME@localhost:5432/institutional_proximity
DATABASE_URL_EDITOR=postgres://ip_editor:CHANGE_ME@localhost:5432/institutional_proximity

# Passwords assigned to the runtime roles when migrations create them.
IP_PUBLIC_PASSWORD=CHANGE_ME
IP_EDITOR_PASSWORD=CHANGE_ME

# Random 32+ byte secret for signing session cookies and CSRF tokens.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Set to true behind HTTPS so cookies get the Secure flag.
COOKIE_SECURE=false

# Hosted alternative: set only DATABASE_URL (owner) plus the two role passwords above;
# the public and editor URLs are derived from it.
# DATABASE_URL=postgres://postgres:CHANGE_ME@host:5432/railway

# Behind a single reverse proxy (Railway, Render, etc.)
TRUST_PROXY=false

# Owner-authorised: publish the AI-reviewed candidate set during release, labelled
# "Checked by AI, not yet by a person". Leave false to require human review.
AI_PUBLISH_REVIEWED_CANDIDATES=false
